# MySQL connection string used by the app (SQLAlchemy + PyMySQL driver)
DATABASE_URL=mysql+pymysql://monq_user:monq_password@localhost:3306/monq

# Google Gemini API key (from aistudio.google.com -> API Keys), used for embeddings
# (gemini-embedding-001) and chat/classification (gemini-flash-lite-latest)
GEMINI_API_KEY=your-gemini-key-here

# Optional overrides (defaults shown)
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
CHUNK_TOKEN_BUDGET=500
CHUNK_TOKEN_OVERLAP=75
RAG_TOP_K=5
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:3000
